[Unit]
Description=ZEUS-POC Agent Runtime
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openclaw-poc
ExecStart=/opt/openclaw-poc/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
