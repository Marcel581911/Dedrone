generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../data/zeus.db"
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Agent {
  id            String         @id @default(uuid())
  name          String
  description   String         @default("")
  role          String         @default("")
  mission       String         @default("")
  systemPrompt  String         @default("You are a helpful assistant.")
  model         String         @default("gpt-4o-mini")
  temperature   Float          @default(0.7)
  maxTokens     Int            @default(2048)
  enabled       Boolean        @default(true)
  tags          String         @default("[]")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  memories      Memory[]
  tickets       Ticket[]
  isSystem           Boolean        @default(false)
  agentSkills        AgentSkill[]
  telegramPairings   TelegramPairing[]
  scheduledTasks     ScheduledTask[]
}

model Conversation {
  id        String    @id @default(uuid())
  agentId   String
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Memory {
  id        String   @id @default(uuid())
  agentId   String
  type      String   @default("note")
  content   String
  ticketId  String?
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  priority    String   @default("medium")
  status      String   @default("queued")
  agentId     String?
  output      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Skill {
  id                 String       @id @default(uuid())
  name               String       @unique
  description        String       @default("")
  inputSchema        String       @default("{}")
  outputSchema       String       @default("{}")
  implementationPath String       @default("")
  enabled            Boolean      @default(true)
  version            String       @default("1.0.0")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  agentSkills        AgentSkill[]
}

model AgentSkill {
  id      String @id @default(uuid())
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
}

model SkillGap {
  id             String   @id @default(uuid())
  skillName      String
  triggerContext String   @default("")
  agentId        String?
  resolved       Boolean  @default(false)
  generatedPath  String?
  createdAt      DateTime @default(now())
}

model TelegramPairing {
  id             String   @id @default(uuid())
  telegramChatId String   @unique
  agentId        String
  conversationId String?
  chatTitle      String   @default("")
  createdAt      DateTime @default(now())
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model TelegramPairingCode {
  id        String   @id @default(uuid())
  code      String   @unique
  agentId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ScheduledTask {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  intervalMin Int      @default(60)
  agentId     String?
  enabled     Boolean  @default(true)
  taskType    String   @default("system")
  taskConfig  String   @default("{}")
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastResult  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Automation {
  id          String   @id @default(uuid())
  what        String
  systems     String   @default("")
  frequency   String   @default("")
  dataSource  String   @default("")
  delivery    String   @default("")
  status      String   @default("draft")
  ticketId    String?
  testResult  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailMessage {
  id          String   @id @default(uuid())
  messageId   String   @default("")
  from        String
  to          String
  subject     String
  body        String
  htmlBody    String   @default("")
  date        DateTime @default(now())
  folder      String   @default("INBOX")
  isRead      Boolean  @default(false)
  summary     String   @default("")
  attachments String   @default("[]")
  direction   String   @default("inbound")
  createdAt   DateTime @default(now())
}

model LogEntry {
  id        String   @id @default(uuid())
  level     String   @default("info")
  source    String   @default("system")
  message   String
  meta      String   @default("{}")
  createdAt DateTime @default(now())
}
