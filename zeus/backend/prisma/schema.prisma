generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(uuid())
  name                 String          @unique
  passwordHash         String
  role                 String          @default("user")
  city                 String          @default("")
  timezone             String          @default("UTC")
  assistantName        String          @default("Gulli")
  assistantPersonality String          @default("")
  phone                String          @default("")
  telegramChatId       String          @default("")
  telegramBotToken     String          @default("")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  agents               Agent[]
  tickets              Ticket[]
  notes                Note[]
  reminders            Reminder[]
  calendarEvents       CalendarEvent[]
  notifications        Notification[]
  accounts             BankAccount[]
  transactions         Transaction[]
  assets               Asset[]
  stockHoldings        StockHolding[]
  debts                Debt[]
  supportTickets       SupportTicket[]  @relation("SupportTicketUser")
  assignedTickets      SupportTicket[]  @relation("SupportTicketAssignee")
  supportComments      SupportComment[]
  shops            Shop[]
  shoppingItems    ShoppingItem[]
  priceAlerts      PriceAlert[]
  shoppingRules    ShoppingRule[]
  trips                Trip[]
  pois                 POI[]
  automations          Automation[]
  connectionRequests   ConnectionRequest[]
  sessions             Session[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InviteCode {
  id        String   @id @default(uuid())
  code      String   @unique
  role      String   @default("user")
  createdBy String
  usedBy    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Agent {
  id                String            @id @default(uuid())
  name              String
  description       String            @default("")
  role              String            @default("")
  mission           String            @default("")
  systemPrompt      String            @default("You are a helpful assistant.")
  model             String            @default("gpt-4o-mini")
  temperature       Float             @default(0.7)
  maxTokens         Int               @default(2048)
  enabled           Boolean           @default(true)
  tags              String            @default("[]")
  isSystem          Boolean           @default(false)
  moduleSlug        String?
  userId            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  memories          Memory[]
  tickets           Ticket[]
  agentSkills       AgentSkill[]
  telegramPairings  TelegramPairing[]
  scheduledTasks    ScheduledTask[]
}

model Conversation {
  id        String    @id @default(uuid())
  agentId   String
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Memory {
  id         String   @id @default(uuid())
  agentId    String
  type       String   @default("note")
  content    String
  ticketId   String?
  embedding  String   @default("")
  chunkIndex Int      @default(0)
  sourceId   String?
  relevance  Float    @default(1.0)
  createdAt  DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String    @id @default(uuid())
  title       String
  description String    @default("")
  priority    String    @default("medium")
  status      String    @default("queued")
  category    String    @default("Personal")
  agentId     String?
  userId      String?
  output      String    @default("")
  dueAt       DateTime?
  recurring   String    @default("")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Skill {
  id                 String       @id @default(uuid())
  name               String       @unique
  description        String       @default("")
  inputSchema        String       @default("{}")
  outputSchema       String       @default("{}")
  implementationPath String       @default("")
  enabled            Boolean      @default(true)
  version            String       @default("1.0.0")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  agentSkills        AgentSkill[]
}

model AgentSkill {
  id      String @id @default(uuid())
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
}

model SkillGap {
  id             String   @id @default(uuid())
  skillName      String
  triggerContext String   @default("")
  agentId        String?
  resolved       Boolean  @default(false)
  generatedPath  String?
  createdAt      DateTime @default(now())
}

model TelegramPairing {
  id             String   @id @default(uuid())
  telegramChatId String   @unique
  agentId        String
  conversationId String?
  chatTitle      String   @default("")
  createdAt      DateTime @default(now())
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model TelegramPairingCode {
  id        String   @id @default(uuid())
  code      String   @unique
  agentId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ScheduledTask {
  id          String    @id @default(uuid())
  name        String
  description String    @default("")
  intervalMin Int       @default(60)
  agentId     String?
  enabled     Boolean   @default(true)
  taskType    String    @default("system")
  taskConfig  String    @default("{}")
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastResult  String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Automation {
  id         String   @id @default(uuid())
  userId     String?
  what       String
  systems    String   @default("")
  frequency  String   @default("")
  dataSource String   @default("")
  delivery   String   @default("")
  status     String   @default("draft")
  ticketId   String?
  testResult String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConnectionRequest {
  id          String   @id @default(uuid())
  userId      String
  service     String
  description String   @default("")
  status      String   @default("pending")
  adminNote   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailMessage {
  id          String   @id @default(uuid())
  messageId   String   @default("")
  from        String
  to          String
  subject     String
  body        String
  htmlBody    String   @default("")
  date        DateTime @default(now())
  folder      String   @default("INBOX")
  isRead      Boolean  @default(false)
  summary     String   @default("")
  attachments String   @default("[]")
  direction   String   @default("inbound")
  createdAt   DateTime @default(now())
}

model Module {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String    @default("")
  version     String    @default("1.0.0")
  author      String    @default("")
  icon        String    @default("")
  status      String    @default("available")
  config      String    @default("{}")
  manifest    String    @default("{}")
  installedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Reminder {
  id        String   @id @default(uuid())
  title     String
  dueAt     DateTime
  recurring String   @default("")
  status    String   @default("pending")
  notified  Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  type      String   @default("info")
  title     String
  body      String   @default("")
  read      Boolean  @default(false)
  link      String   @default("")
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String    @default("")
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  location    String    @default("")
  source      String    @default("manual")
  sourceId    String    @default("")
  color       String    @default("")
  userId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Note {
  id        String   @id @default(uuid())
  title     String   @default("")
  content   String
  pinned    Boolean  @default(false)
  color     String   @default("")
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model BankAccount {
  id           String        @id @default(uuid())
  userId       String
  name         String
  type         String        @default("checking")
  currency     String        @default("EUR")
  balance      Float         @default(0)
  institution  String        @default("")
  color        String        @default("")
  lastSyncAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id           String      @id @default(uuid())
  accountId    String
  userId       String
  date         DateTime
  description  String
  amount       Float
  category     String      @default("Other")
  notes        String      @default("")
  isReconciled Boolean     @default(false)
  createdAt    DateTime    @default(now())
  account      BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id            String    @id @default(uuid())
  userId        String
  name          String
  type          String
  value         Float
  currency      String    @default("EUR")
  purchasePrice Float     @default(0)
  purchaseDate  DateTime?
  notes         String    @default("")
  metadata      String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StockHolding {
  id        String   @id @default(uuid())
  userId    String
  ticker    String
  name      String   @default("")
  shares    Float
  avgCost   Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Debt {
  id             String    @id @default(uuid())
  userId         String
  name           String
  type           String    @default("other")
  balance        Float
  originalAmount Float     @default(0)
  interestRate   Float     @default(0)
  monthlyPayment Float     @default(0)
  currency       String    @default("EUR")
  dueDate        DateTime?
  notes          String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiUsage {
  id               String   @id @default(uuid())
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCost    Float    @default(0)
  createdAt        DateTime @default(now())
}

model LogEntry {
  id        String   @id @default(uuid())
  level     String   @default("info")
  source    String   @default("system")
  message   String
  meta      String   @default("{}")
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String           @id @default(uuid())
  title       String
  description String           @default("")
  type        String           @default("support")
  status      String           @default("open")
  priority    String           @default("medium")
  userId      String?
  assignedTo  String?
  resolution  String           @default("")
  tags        String           @default("[]")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: SetNull)
  assignee    User?            @relation("SupportTicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  comments    SupportComment[]
}

model SupportComment {
  id        String        @id @default(uuid())
  ticketId  String
  userId    String?
  content   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Shop {
  id        String         @id @default(uuid())
  userId    String
  name      String
  url       String         @default("")
  color     String         @default("")
  icon      String         @default("")
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]
  alerts    PriceAlert[]
}

model ShoppingItem {
  id        String   @id @default(uuid())
  userId    String
  shopId    String?
  name      String
  quantity  String   @default("1")
  category  String   @default("")
  notes     String   @default("")
  url       String   @default("")
  price     Float?
  status    String   @default("pending")
  addedBy   String   @default("user")
  priority  String   @default("normal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
}

model PriceAlert {
  id           String         @id @default(uuid())
  userId       String
  shopId       String?
  productName  String
  productUrl   String
  asin         String         @default("")
  targetPrice  Float
  currentPrice Float?
  currency     String         @default("USD")
  lastChecked  DateTime?
  triggered    Boolean        @default(false)
  active       Boolean        @default(true)
  notes        String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop         Shop?          @relation(fields: [shopId], references: [id], onDelete: SetNull)
  history      PriceHistory[]
}

model PriceHistory {
  id        String     @id @default(uuid())
  alertId   String
  price     Float
  createdAt DateTime   @default(now())
  alert     PriceAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model ShoppingRule {
  id        String   @id @default(uuid())
  userId    String
  shopId    String?
  itemName  String
  quantity  String   @default("1")
  category  String   @default("")
  trigger   String   @default("weekly")
  lastRun   DateTime?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Travel ────────────────────────────────────────────────────────────────────

model Trip {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  destination String      @default("")
  homeAirport String      @default("SFO")
  startDate   DateTime
  endDate     DateTime
  status      String      @default("upcoming") // upcoming, active, completed
  coverEmoji  String      @default("✈️")
  notes       String      @default("")
  events      TripEvent[]
  pois        POI[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model TripEvent {
  id              String          @id @default(uuid())
  tripId          String
  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type            String          // flight, hotel, activity, transport, car_rental
  title           String
  startTime       DateTime
  endTime         DateTime?
  location        String          @default("")
  address         String          @default("")
  bookingRef      String          @default("")
  confirmationNum String          @default("")
  notes           String          @default("")
  flightNumber    String          @default("")
  airline         String          @default("")
  fromAirport     String          @default("")
  toAirport       String          @default("")
  terminal        String          @default("")
  gate            String          @default("")
  flightStatus    String          @default("scheduled") // scheduled, on-time, delayed, cancelled, landed
  delayMinutes    Int             @default(0)
  tracking        FlightTracking?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model FlightTracking {
  id             String     @id @default(uuid())
  eventId        String     @unique
  event          TripEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  subscriptionId String     @default("")
  active         Boolean    @default(true)
  lastChecked    DateTime?
  lastStatus     String     @default("")
  createdAt      DateTime   @default(now())
}

model POI {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  name      String
  address   String   @default("")
  city      String   @default("")
  country   String   @default("")
  category  String   @default("") // restaurant, museum, hotel, attraction, transport, other
  notes     String   @default("")
  visitedAt DateTime?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
